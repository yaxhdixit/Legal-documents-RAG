  "invariants": [
    {
      "id": "INVARIANT-1c20658c",
      "text": "The system must never present AI risk assessments as definitive legal conclusions; all risk labels represent review priorities to support, not replace, legal professionals.",
      "source": "USER_REQUEST Section 1 & 2C",
      "recorded_at": "2026-11-01T15:20:37.081Z",
      "paths": [],
      "tags": []
    },
    {
      "id": "INVARIANT-eeb8bf8f",
      "text": "All conversational responses and risk findings must be grounded in contract evidence, referencing exact text and document sections/pages without hallucinating legal provisions.",
      "source": "USER_REQUEST Section 2C, 2D, 6",
      "recorded_at": "2026-11-01T15:20:37.139Z",
      "paths": [],
      "tags": []
    }
  ],
  "decisions": [
    {
      "id": "DECISION-594bc88e",
      "title": "CGL Branding and Legal Professional Workflow",
      "text": "Design application styling and UX inspired by Confrere Global Legale (cgl.world / cgladr.world) with navy/slate/gold palette, split-screen original document viewer and clause evidence, and advisory risk review priorities rather than definitive legal conclusions.",
      "status": "accepted",
      "source": "USER_REQUEST Section 1 & 7",
      "recorded_at": "2026-11-01T15:20:22.930Z",
      "paths": [],
      "tags": []
    },
    {
      "id": "DECISION-da674aad",
      "title": "Primary Dataset Strategy: CUAD, ACORD, and ContractNLI",
      "text": "Use official CUAD (clause identification/extraction), ACORD (query-clause semantic retrieval), and ContractNLI (evidence verification/entailment) under CC BY 4.0 with contract-level train/validation/test split isolation to prevent data leakage.",
      "status": "accepted",
      "source": "USER_REQUEST Section 3 & 4",
      "recorded_at": "2026-11-01T15:20:30.093Z",
      "paths": [],
      "tags": []
    },
    {
      "id": "DECISION-f030b7c5",
      "title": "Model Architecture: 1B-3B SLM with PEFT LoRA and Clause RAG",
      "text": "Target instruction-following 1B-3B parameter SLM (e.g. Qwen2.5 or Llama-3.2) fine-tuned via PEFT/LoRA on chat-formatted contract SFT records, combined with a clause-aware vector retrieval layer for evidence grounding.",
      "status": "accepted",
      "source": "USER_REQUEST Section 5 & 6",
      "recorded_at": "2026-11-01T15:20:37.013Z",
      "paths": [],
      "tags": []
    }
  ],
  "knowledge": [
    {
      "id": "KNOWLEDGE-21704e0b",
      "title": "Dataset Provenance and Licensing",
      "text": "CUAD, ACORD, and ContractNLI are CC BY 4.0 licensed expert-annotated legal datasets. Preprocessing must isolate by contract ID and normalize spans into a unified intermediate contract schema.",
      "source": "USER_REQUEST Section 3",
      "tags": [],
      "recorded_at": "2026-11-01T15:20:44.470Z",
      "paths": []
    }
  ],
